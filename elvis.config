[
    {config, [
        #{
            files => ["src/*.erl"],
            ruleset => erl_files,
            rules => [
                % The public XML tuple contract permits construction and pattern matching (#27).
                {elvis_style, private_data_types, #{ignore => [signerl_xml]}},
                % OTP ASN.1 record names and fields use their specified mixed-case spelling.
                {elvis_style, atom_naming_convention, #{ignore => [signerl_cert]}}
            ]
        },
        #{
            files => ["test/*.erl"],
            ruleset => erl_files,
            rules => [
                % Certificate/consumer fixtures use OTP ASN.1 names; the equivalence probe uses OTP namedCurve.
                {elvis_style, atom_naming_convention, #{ignore => [signerl_cert_helpers, signerl_cert_test, xmlan_contract_consumer, signerl_external_consumer, signerl_xmlan_equivalence_SUITE]}}
            ]
        }
    ]}
].
