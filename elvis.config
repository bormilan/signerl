[
    {config, [
        #{
            files => ["src/*.erl"],
            ruleset => erl_files,
            rules => [
                % Callers inspect the simplified xmerl tree; its type is intentionally transparent.
                {elvis_style, private_data_types, #{ignore => [signerl_xml]}},
                % OTP ASN.1 record names and fields use their specified mixed-case spelling.
                {elvis_style, atom_naming_convention, #{ignore => [signerl_cert]}}
            ]
        },
        #{
            files => ["test/*.erl"],
            ruleset => erl_files,
            rules => [
                % Certificate fixtures use the same OTP ASN.1 record names and fields.
                {elvis_style, atom_naming_convention, #{ignore => [signerl_cert_helpers, signerl_cert_test]}}
            ]
        }
    ]}
].
