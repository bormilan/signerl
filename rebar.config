{erl_opts, [debug_info]}.
{deps, []}.

{alias, [
    {test, [
        fmt,
        {eunit, "--cover false"},
        {ct, "--cover verbose true"},
        {cover, "--min_coverage 100"}
    ]},
    {tall, [
        fmt,
        {eunit, "--cover false"},
        xref,
        dialyzer,
        {ct, "--name ct --sys_config=config/sys.config --readable true --cover verbose true"},
        {cover, "--min_coverage 100"}
    ]},
    {flint, [
        fmt,
        lint
    ]}
]}.

{cover_opts, [verbose]}.

{project_plugins, [
    erlfmt,
    {rebar3_lint, "4.1.1"}
]}.

{erlfmt, [write]}.

{shell, [
    % {config, "config/sys.config"},
    {apps, [signerl]}
]}.
