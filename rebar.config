{erl_opts, [debug_info]}.
{deps, []}.

{alias, [
    {test, [
        fmt,
        {cover, "--reset"},
        {eunit, "--cover false"},
        {ct, "--cover verbose true"},
        {cover, "--min_coverage 100"}
    ]},
    {tall, [test, lint, xref, dialyzer]},
    {flint, [
        fmt,
        lint
    ]}
]}.

{cover_opts, [verbose]}.

% Consumers of this library's exports are outside Xref's application graph.
% Check calls and local functions without suppressing any public function body.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{project_plugins, [
    erlfmt,
    {rebar3_lint, "4.1.1"}
]}.

{erlfmt, [write]}.

{shell, [
    % {config, "config/sys.config"},
    {apps, [signerl]}
]}.
