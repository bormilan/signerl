# erlfmt emits LF on every platform; keep its inputs consistent at checkout.
*.erl text eol=lf
*.hrl text eol=lf
*.app.src text eol=lf
/rebar.config text eol=lf

# XML migration goldens are byte oracles on every supported OS.
test/examples/xmlan_migration/*.xml -text
test/examples/xmlan_migration/*.pem text eol=lf
test/examples/xmlan_migration/*.term text eol=lf
test/examples/xmlan_migration/SHA256SUMS text eol=lf

# The portable baseline preparation script is also executed by Git Bash.
scripts/prepare_xml_baseline.sh text eol=lf
scripts/check_external_consumer.sh text eol=lf
scripts/check_dependency_tree.sh text eol=lf
